# Configura estas variables en Project Settings > Environment Variables de Vercel.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=

# Los dominios de Vercel se detectan automáticamente. Agrega aquí los adicionales.
# DJANGO_ALLOWED_HOSTS=roadvision.midominio.com

ROADVISION_ORIGEN_MODELOS=supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_MODELOS_BUCKET=modelos

# Configura una de estas dos claves públicas.
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Opcional. En Vercel el valor predeterminado es 2.
# ROADVISION_HILOS=2
